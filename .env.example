# Client-side (Vite only exposes VITE_* to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only — do NOT add a VITE_ prefix (never ship this to the browser)
# Used later for Edge Functions / admin; keep out of the frontend bundle
# SUPABASE_SECRET_KEY=
# BGG_API_TOKEN=

# Cursor MCP (optional) — personal access token from
# https://supabase.com/dashboard/account/tokens
# Put this in your shell env or ~/.cursor/mcp.json, not in the Vite client.
# SUPABASE_ACCESS_TOKEN=

# Local: true uses the Vite /api/bgg proxy. Production GitHub Pages build
# also sets this so the client calls the Supabase Edge Function.
VITE_BGG_LOOKUP_ENABLED=false
